<Window x:Class="PingGlassWindows.Notifications.FloatingChatPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="342"
        Height="414"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        ResizeMode="NoResize">

    <Border x:Name="PopupRoot" CornerRadius="20" BorderThickness="1" BorderBrush="#40FFFFFF">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#CC192921" Offset="0.0"/>
                <GradientStop Color="#D613161C" Offset="0.35"/>
                <GradientStop Color="#D8101217" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Padding="12,10" BorderBrush="#24FFFFFF" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#40000000"
                            BorderBrush="#25D366" BorderThickness="1.2" Margin="0,0,8,0">
                        <TextBlock x:Name="AvatarInitials" Text="WA" FontSize="12" FontWeight="SemiBold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ChatTitleText" Text="WhatsApp Chat" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="145"/>
                            <Border x:Name="TestPill" Visibility="Collapsed" Background="#3325D366" CornerRadius="7"
                                    Padding="5,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="TEST" FontSize="8.5" FontWeight="Bold" Foreground="#25D366"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Ellipse x:Name="SyncDot" Width="6" Height="6" Fill="#99FFFFFF" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SubtitleText" Text="Session Chat" FontSize="10.5" Foreground="#99FFFFFF"
                                       TextTrimming="CharacterEllipsis" MaxWidth="155"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CopyAllBtn" Click="CopyAllBtn_Click" ToolTip="Copy full conversation"
                                Width="24" Height="24" Margin="0,0,3,0" BorderThickness="0" Background="#1FFFFFFF"
                                Foreground="#CCFFFFFF" Content="⧉" FontSize="11" Cursor="Hand"/>
                        <Button Click="OpenWhatsAppBtn_Click" ToolTip="Open in WhatsApp Desktop"
                                Width="24" Height="24" Margin="0,0,3,0" BorderThickness="0" Background="#1FFFFFFF"
                                Foreground="#CCFFFFFF" Content="↗" FontSize="12" Cursor="Hand"/>
                        <Button Click="RefreshBtn_Click" ToolTip="Refresh visible messages"
                                Width="24" Height="24" Margin="0,0,3,0" BorderThickness="0" Background="#1FFFFFFF"
                                Foreground="#CCFFFFFF" Content="↻" FontSize="12" Cursor="Hand"/>
                        <Button Click="CloseBtn_Click" ToolTip="Close chat popup"
                                Width="24" Height="24" BorderThickness="0" Background="#1FFFFFFF"
                                Foreground="#CCFFFFFF" Content="✕" FontSize="11" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Messages ScrollView -->
            <ScrollViewer x:Name="MessagesScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="11,10">
                <StackPanel x:Name="MessagesPanel"/>
            </ScrollViewer>

            <!-- Composer Footer -->
            <Border Grid.Row="2" Padding="11,9" BorderBrush="#24FFFFFF" BorderThickness="0,1,0,0">
                <StackPanel>
                    <!-- Quick Reply Chips -->
                    <StackPanel x:Name="QuickChipsPanel" Orientation="Horizontal" Margin="0,0,0,6"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" CornerRadius="11" Background="#18FFFFFF" BorderBrush="#30FFFFFF"
                                BorderThickness="1" Padding="8,5" Margin="0,0,7,0">
                            <TextBox x:Name="ReplyTextBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="White"
                                     CaretBrush="#25D366"
                                     FontSize="12.2"
                                     TextWrapping="Wrap"
                                     MaxHeight="64"
                                     VerticalScrollBarVisibility="Auto"
                                     PreviewKeyDown="ReplyTextBox_PreviewKeyDown"
                                     TextChanged="ReplyTextBox_TextChanged"/>
                        </Border>

                        <Button x:Name="SendBtn" Grid.Column="1" Click="SendBtn_Click"
                                Width="30" Height="30" IsEnabled="False" BorderThickness="0"
                                Background="#25D366" Foreground="White" Content="➤" FontSize="12.5" Cursor="Hand"
                                ToolTip="Send reply via WhatsApp Desktop"/>
                    </Grid>

                    <TextBlock x:Name="ReplyStatusText" Text="Local-only · Enter to send via WhatsApp"
                               FontSize="10" Foreground="#8EFFFFFF" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
